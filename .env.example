# ------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit .env.
# ------------------------------------------------------------------

# --- PostgreSQL (source: Digital_Money) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=Digital_Money
POSTGRES_USER=your_pg_user
POSTGRES_PASSWORD=your_pg_password
POSTGRES_SCHEMA=public
POSTGRES_CONNECT_TIMEOUT_SECONDS=10

# --- Node.js API (source: transactions) ---
API_BASE_URL=http://localhost:3000/api
API_TRANSACTIONS_ENDPOINT=/transactions
API_TIMEOUT_SECONDS=30
API_MAX_RETRIES=3
API_RETRY_BACKOFF_SECONDS=2
API_PAGE_SIZE=200
# Optional, only if the API requires auth
API_AUTH_TOKEN=

# --- CSV (source: branches, merchants, devices, payment_methods) ---
CSV_INPUT_DIR=./datasets

# --- Databricks (target Lakehouse) ---
DATABRICKS_SERVER_HOSTNAME=your-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxx
DATABRICKS_TOKEN=your_databricks_pat_token
DATABRICKS_CLUSTER_ID=
BRONZE_SCHEMA=bronze
BRONZE_CATALOG=main

# --- Runtime / local state ---
LOG_LEVEL=INFO
LOG_DIR=./logs
STATE_DIR=./state
# Overrides an auto-generated UUID batch id if set (useful for reruns/debug)
BATCH_ID=
